{
  "expo": {
    "name": "Travel Fitness",
    "slug": "travel-fitness",
    "scheme": "travel-fitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/travel-fitness-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/travel-fitness-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.travelfitness.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access to capture profile pictures and workout videos",
        "NSPhotoLibraryUsageDescription": "We need access to your photos for profile pictures and meal images",
        "NSPhotoLibraryAddOnlyUsageDescription": "We need to save your workout videos and photos",
        "NSMicrophoneUsageDescription": "Microphone access for video uploads"
      },
      "splash": {
        "image": "./assets/travel-fitness-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "deploymentTarget": "14.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/travel-fitness-logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.travelfitness.app"
    },
    "web": {
      "favicon": "./assets/travel-fitness-logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/caveat/400Regular/Caveat_400Regular.ttf"
          ]
        }
      ]
    ]
  }
}
