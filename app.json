{
  "expo": {
    "name": "Travel Fitness",
    "slug": "travel-fitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.travelfitness.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses your camera for video uploads.",
        "NSPhotoLibraryUsageDescription": "This app accesses your photo library for profile pictures.",
        "NSPhotoLibraryAddOnlyUsageDescription": "This app saves photos to your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.travelfitness.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./src/assets/images/favicon.png"
    },
    "description": "Fitness app where people can buy courses from exclusive trainers",
    "plugins": []
  }
}
