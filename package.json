{
  "name": "travel-fitness",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "prebuild": "expo prebuild --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "build:ios": "npm run prebuild:ios && xcodebuild -workspace ios/TravelFitness.xcworkspace -scheme TravelFitness -configuration Release -derivedDataPath ios/build",
    "build:ios:dev": "npm run prebuild:ios && xcodebuild -workspace ios/TravelFitness.xcworkspace -scheme TravelFitness -configuration Debug -derivedDataPath ios/build",
    "xcode": "npm run prebuild:ios && open ios/TravelFitness.xcworkspace",
    "ios:clean": "rm -rf ios/build && rm -rf ios/Pods && rm -rf ios/*.xcworkspace",
    "eject": "expo prebuild --clean",
    "setup": "npm install && npm run prebuild:ios",
    "kill": "pkill -f 'expo start' || true && pkill -f 'node' || true && pkill -f 'xcodebuild' || true"
  },
  "dependencies": {
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "date-fns": "^4.1.0",
    "expo": "~54.0.20",
    "expo-constants": "~18.0.10",
    "expo-file-system": "~19.0.17",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.14",
    "expo-status-bar": "~3.0.8",
    "firebase": "^12.11.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-native": "^5.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
