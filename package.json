{
  "name": "travel-fitness",
  "version": "1.0.0",
  "description": "Fitness app where people can buy courses from exclusive trainers",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:ios": "expo start --ios",
    "start:android": "expo start --android",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:ios:local": "expo prebuild --clean && xcodebuild -workspace ios/TravelFitness.xcworkspace -scheme TravelFitness -configuration Debug -derivedDataPath ios/build",
    "eject": "expo prebuild",
    "test": "jest",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krish2026/travel-fitness.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Krish2026/travel-fitness/issues"
  },
  "homepage": "https://github.com/Krish2026/travel-fitness#readme",
  "dependencies": {
    "expo": "^49.0.23",
    "expo-cli": "^6.3.12",
    "expo-constants": "^55.0.9",
    "expo-device": "^55.0.10",
    "expo-notifications": "^55.0.13",
    "firebase": "^12.11.0",
    "react": "^19.2.4",
    "react-native": "^0.84.1"
  }
}
