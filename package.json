{
  "name": "travel-fitness",
  "version": "1.0.0",
  "description": "Fitness app where people can buy courses from exclusive trainers",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:ios": "expo start --ios",
    "start:android": "expo start --android",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:ios:local": "expo prebuild --clean && xcodebuild -workspace ios/TravelFitness.xcworkspace -scheme TravelFitness -configuration Debug -derivedDataPath ios/build",
    "eject": "expo prebuild",
    "test": "jest",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src/",
    "kill": "lsof -ti:8080,9099,9199,4000,4400,3000,3001,8081 2>/dev/null | xargs kill -9 2>/dev/null; echo 'Ports cleared'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krish2026/travel-fitness.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Krish2026/travel-fitness/issues"
  },
  "homepage": "https://github.com/Krish2026/travel-fitness#readme",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.6",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/stack": "^7.8.6",
    "expo": "^49.0.23",
    "expo-cli": "^6.3.12",
    "expo-constants": "^55.0.9",
    "expo-device": "^55.0.10",
    "expo-notifications": "^55.0.13",
    "firebase": "^12.11.0",
    "react": "^19.2.4",
    "react-native": "^0.84.1",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0"
  }
}
